---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LogoSymbols from '../components/LogoSymbols.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Override the canonical path (e.g. '/finder'). Defaults to the current URL path. */
  canonicalPath?: string;
  /** Emit `noindex` and skip the canonical tag (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex = false } = Astro.props;

// One canonical form for every page: https://findfrolf.com + path with no
// trailing slash and no `.html` (the root stays `/`). Query strings are dropped.
const SITE = 'https://findfrolf.com';
function normalizePath(path: string): string {
  let p = path.split(/[?#]/)[0] || '/';
  p = p.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
  if (p.length > 1) p = p.replace(/\/+$/, '');
  return p || '/';
}
const canonicalUrl = SITE + normalizePath(canonicalPath ?? Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="google-adsense-account" content="ca-pub-5424097145643842" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Caveat:wght@600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <LogoSymbols />
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
