---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { title, description, eyebrow, ctaHref = '/', ctaLabel = 'Back to home' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="max-w-[1240px] mx-auto px-8 py-32 text-center">
    <svg class="w-24 h-24 mx-auto mb-6"><use href="#ff-mark" /></svg>
    <div class="eyebrow mb-5">§ {eyebrow}</div>
    <h1 class="font-display font-normal text-[clamp(40px,6vw,72px)] leading-[0.95] tracking-[-2px] text-forest-deep mb-5 max-w-[820px] mx-auto">
      <slot name="heading" />
    </h1>
    <p class="text-lg text-ink-soft max-w-[520px] mx-auto mb-10">
      <slot name="body" />
    </p>
    <div class="inline-flex items-center gap-3 bg-paper border-[1.5px] border-line rounded-full px-5 py-2.5 font-mono text-[11px] uppercase tracking-[2px] text-moss mb-12">
      <span class="w-2 h-2 rounded-full bg-clay animate-pulse"></span>
      In the works &middot; dropping soon
    </div>
    <div>
      <a href={ctaHref} class="inline-flex items-center gap-2 bg-clay text-white px-6 py-3 rounded-full font-bold text-sm no-clip hover:bg-clay-deep transition-colors">
        {ctaLabel} →
      </a>
    </div>
  </section>
</BaseLayout>
