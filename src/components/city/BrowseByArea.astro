---
interface Area {
  count: number;
  name: string;
}

interface Props {
  areas: Area[];
  cityName: string;
}

const { areas, cityName } = Astro.props;
---

<section class="max-w-[1240px] mx-auto px-8 pb-20">
  <div class="eyebrow mb-3">§ 04 — Browse by area</div>
  <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-3 max-w-[760px]">
    Courses by <em class="italic text-clay">neighborhood</em>
  </h2>
  <p class="text-base text-ink-soft max-w-[580px] mb-10">
    {cityName}'s spread out — find the chains closest to your side of town.
  </p>
  <div class="grid grid-cols-3 lg:grid-cols-6 gap-4">
    {areas.map((area) => (
      <a
        href="#"
        class="bg-paper border border-line rounded-[10px] p-5 text-center no-clip transition-all hover:border-clay hover:-translate-y-0.5"
      >
        <div class="font-display font-semibold text-[30px] text-clay leading-none">{area.count}</div>
        <div class="text-[13px] text-forest-deep font-semibold mt-1.5">{area.name}</div>
      </a>
    ))}
  </div>
</section>
