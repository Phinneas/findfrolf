---
interface Props {
  titleHtml?: string;
  buttonText?: string;
}

const {
  titleHtml = "Know an Austin course <span class='script text-sun'>we're missing?</span>",
  buttonText = "Add a course →",
} = Astro.props;
---

<section class="max-w-[1240px] mx-auto px-8 py-20">
  <div class="bg-clay text-white rounded-[14px] p-9 lg:p-14 flex justify-between items-center gap-10 flex-wrap">
    <h2 class="font-display font-normal text-[34px] tracking-[-1px] leading-[1.05]" set:html={titleHtml} />
    <a href="/add-course" class="bg-forest-deep text-cream px-[30px] py-[15px] rounded-full no-clip font-bold text-[15px] whitespace-nowrap hover:bg-black transition-colors">
      {buttonText}
    </a>
  </div>
</section>
