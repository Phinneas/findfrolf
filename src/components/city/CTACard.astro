---
interface Props {
  titleHtml?: string;
  buttonText?: string;
  cityName?: string;
}

const { titleHtml, buttonText = 'Add a course →', cityName } = Astro.props;

const article = cityName && /^[aeiou]/i.test(cityName) ? 'an' : 'a';
const defaultTitle = cityName
  ? `Know ${article} ${cityName} course <span class='script text-sun'>we're missing?</span>`
  : `Know a course <span class='script text-sun'>we're missing?</span>`;
const resolvedTitle = titleHtml ?? defaultTitle;
---

<section class="max-w-[1240px] mx-auto px-8 py-20">
  <div class="bg-clay text-white rounded-[14px] p-9 lg:p-14 flex justify-between items-center gap-10 flex-wrap">
    <h2 class="font-display font-normal text-[34px] tracking-[-1px] leading-[1.05]" set:html={resolvedTitle} />
    <a href="/contact/" class="bg-forest-deep text-cream px-[30px] py-[15px] rounded-full no-clip font-bold text-[15px] whitespace-nowrap hover:bg-black transition-colors">
      {buttonText}
    </a>
  </div>
</section>
