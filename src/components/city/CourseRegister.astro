---
import { courseUrl } from '../../lib/data';
import type { CollectionEntry } from 'astro:content';

interface Props {
  courses: CollectionEntry<'courses'>[];
  totalCount?: number;
  cityName?: string;
}

const { courses, totalCount, cityName } = Astro.props;

const chips = ['All', 'Free', 'Beginner-friendly', 'Wooded', '18+ holes', 'Quick 9', 'Dog friendly', 'Open now'];
---

<section class="max-w-[1240px] mx-auto px-8 py-20">
  <div class="eyebrow mb-3">§ 01 — Ranked by players</div>
  <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-3 max-w-[760px]">
    The best disc golf courses {cityName && <em class="italic text-clay">in {cityName}</em>}
  </h2>
  <p class="text-base text-ink-soft max-w-[580px] mb-10">
    Ordered by player rating across verified rounds. Filter by what you're in the mood for.
  </p>

  <div class="flex gap-2.5 flex-wrap mb-8">
    {chips.map((chip, i) => (
      <a
        href="#"
        class={`px-[17px] py-[9px] rounded-full text-[13px] font-bold no-underline transition-all ${i === 0 ? 'bg-clay text-white border border-clay' : 'bg-paper border-[1.5px] border-line text-forest hover:bg-forest hover:text-cream hover:border-forest'}`}
      >
        {chip}{i === 0 && totalCount ? ` ${totalCount}` : ''}
      </a>
    ))}
  </div>

  <!-- Header row (desktop only) -->
  <div class="hidden md:grid grid-cols-[50px_56px_2.1fr_1.2fr_1.1fr_60px] gap-[22px] items-center px-5 pb-3 font-mono text-[10px] uppercase tracking-[1.5px] text-moss border-b-[1.5px] border-forest">
    <span></span>
    <span>Rank</span>
    <span>Course</span>
    <span>Area</span>
    <span>Layout</span>
    <span class="text-right">★</span>
  </div>

  <!-- Course rows -->
  <div class="register">
    {courses.map((course, i) => {
      const rank = String(i + 1).padStart(2, '0');
      const isTop = i < 3;
      return (
        <a
          href={courseUrl(course)}
          class="grid grid-cols-[44px_1fr_auto] md:grid-cols-[50px_56px_2.1fr_1.2fr_1.1fr_60px] gap-3.5 md:gap-[22px] items-center px-2 md:px-5 py-4 border-b border-line no-clip text-inherit transition-colors hover:bg-cream-2"
        >
          <div class={`hidden md:block w-14 h-[50px] rounded-md bg-cover bg-center border-[1.5px] border-forest`} style={`background-image:url('${course.data.thumbnail}')`}></div>
          <div class={`font-display ${isTop ? 'font-bold not-italic text-clay' : 'italic text-sage'} text-[24px]`}>{rank}</div>
          <div>
            <div class="font-display font-semibold text-[20px] text-forest-deep tracking-[-0.5px] leading-[1.05]">{course.data.name}</div>
            <div class="font-mono text-[10px] uppercase tracking-[0.5px] text-moss mt-1">{course.data.code} · {course.data.tags.slice(0, 2).join(' · ')}</div>
          </div>
          <div class="hidden md:block text-sm text-ink-soft">{course.data.area}</div>
          <div class="hidden md:block font-mono text-xs text-forest">{course.data.holes} · Par {course.data.par} · {course.data.isFree ? 'Free' : course.data.greenFee}</div>
          <div class="font-display font-bold text-[20px] text-clay text-right">{course.data.rating}</div>
        </a>
      );
    })}
  </div>

  {totalCount && totalCount > courses.length && (
    <div class="pt-7 px-5">
      <a href="#" class="font-mono text-xs uppercase tracking-[2px] text-forest no-underline border-b-[1.5px] border-clay pb-1">
        See all {totalCount}{cityName ? ` ${cityName}` : ''} courses →
      </a>
    </div>
  )}
</section>
