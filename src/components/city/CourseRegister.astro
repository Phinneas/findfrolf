---
import { courseUrl, formatGreenFee, isPlaceholderImage } from '../../lib/data';
import type { CollectionEntry } from 'astro:content';

interface Props {
  courses: CollectionEntry<'courses'>[];
  totalCount?: number;
  cityName?: string;
}

const { courses, totalCount, cityName } = Astro.props;

const chips = ['All', 'Free', 'Beginner-friendly', 'Wooded', '18+ holes', 'Quick 9', 'Dog friendly', 'Open now'];

const fmtFeet = (n: number) => (n > 0 ? `${n.toLocaleString('en-US')} ft` : '—');
---

<section class="max-w-[1240px] mx-auto px-8 py-20">
  <div class="eyebrow mb-3">§ 01 — Ranked by players</div>
  <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-3 max-w-[760px]">
    The best disc golf courses {cityName && <em class="italic text-clay">in {cityName}</em>}
  </h2>
  <p class="text-base text-ink-soft max-w-[580px] mb-10">
    Ordered by player rating (sourced from UDisc). Filter by what you're in the mood for.
  </p>

  <div class="flex gap-2.5 flex-wrap mb-8">
    {chips.map((chip, i) => (
      <a
        href="#"
        class={`px-[17px] py-[9px] rounded-full text-[13px] font-bold no-underline transition-all ${i === 0 ? 'bg-clay text-white border border-clay' : 'bg-paper border-[1.5px] border-line text-forest hover:bg-forest hover:text-cream hover:border-forest'}`}
      >
        {chip}{i === 0 && totalCount ? ` ${totalCount}` : ''}
      </a>
    ))}
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[760px] border-collapse">
      <caption class="sr-only">Disc golf courses in {cityName}, ordered by player rating, with hole count, par, length, difficulty, cost, and rating</caption>
      <thead>
        <tr class="border-b-[1.5px] border-forest">
          <th scope="col" class="text-left font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-5 pb-3">Course</th>
          <th scope="col" class="text-left font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-3 pb-3">Holes</th>
          <th scope="col" class="text-left font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-3 pb-3">Par</th>
          <th scope="col" class="text-left font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-3 pb-3">Length</th>
          <th scope="col" class="text-left font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-3 pb-3">Difficulty</th>
          <th scope="col" class="text-left font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-3 pb-3">Cost</th>
          <th scope="col" class="text-right font-mono text-[10px] uppercase tracking-[1.5px] text-moss font-normal px-5 pb-3">Rating</th>
        </tr>
      </thead>
      <tbody>
        {courses.map((course) => (
          <tr class="border-b border-line transition-colors hover:bg-cream-2">
            <td class="px-5 py-4">
              <a href={courseUrl(course)} class="no-underline text-inherit flex items-center gap-3.5">
                {isPlaceholderImage(course.data.thumbnail) ? (
                  <span class="shrink-0 w-12 h-[46px] rounded-md border-[1.5px] border-line bg-cream-2 flex items-center justify-center text-moss text-[10px]">—</span>
                ) : (
                  <img src={course.data.thumbnail} alt="" loading="lazy" class="shrink-0 w-12 h-[46px] rounded-md object-cover border-[1.5px] border-forest" />
                )}
                <span>
                  <span class="block font-display font-semibold text-[19px] text-forest-deep tracking-[-0.5px] leading-[1.08]">{course.data.name}</span>
                  <span class="block font-mono text-[10px] uppercase tracking-[0.5px] text-moss mt-1">{course.data.area}</span>
                </span>
              </a>
            </td>
            <td class="px-3 py-4 font-mono text-xs text-forest whitespace-nowrap">{course.data.holes}</td>
            <td class="px-3 py-4 font-mono text-xs text-forest whitespace-nowrap">{course.data.par}</td>
            <td class="px-3 py-4 font-mono text-xs text-forest whitespace-nowrap">{fmtFeet(course.data.totalFeet)}</td>
            <td class="px-3 py-4 text-sm text-ink-soft whitespace-nowrap">{course.data.difficulty}</td>
            <td class="px-3 py-4 font-mono text-xs text-forest whitespace-nowrap">{formatGreenFee(course.data.isFree, course.data.greenFee)}</td>
            <td class="px-5 py-4 text-right whitespace-nowrap">
              {course.data.rating > 0 ? (
                <span class="font-display font-bold text-[20px] text-clay">{course.data.rating}</span>
              ) : course.data.tags.includes('Private') ? (
                <span class="font-mono text-[10px] uppercase tracking-[1px] text-moss">Private</span>
              ) : (
                <span class="font-mono text-[11px] text-moss">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {totalCount && totalCount > courses.length && (
    <div class="pt-7 px-5">
      <a href="#" class="font-mono text-xs uppercase tracking-[2px] text-forest no-underline border-b-[1.5px] border-clay pb-1">
        See all {totalCount}{cityName ? ` ${cityName}` : ''} courses →
      </a>
    </div>
  )}
</section>
