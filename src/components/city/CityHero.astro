---
interface Props {
  name: string;
  heroImage: string;
  heroFlag: string;
  lede: string;
}

const { name, heroImage, heroFlag, lede } = Astro.props;
---

<section class="max-w-[1240px] mx-auto mt-[18px] px-8">
  <div class="relative rounded-[14px] overflow-hidden min-h-[420px] border-[1.5px] border-forest shadow-stamp-lg flex items-end">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImage}')`}></div>
    <div class="absolute inset-0 bg-gradient-to-b from-forest-deep/25 via-forest-deep/55 to-forest-deep/90"></div>
    <div class="relative z-2 p-11 lg:p-12 text-cream w-full">
      <span class="inline-flex items-center gap-2 bg-clay text-white font-mono text-[10px] uppercase tracking-[2px] px-3 py-1.5 mb-4">
        {heroFlag}
      </span>
      <h1 class="font-display font-normal text-[clamp(40px,6vw,76px)] leading-[0.92] tracking-[-2px] mb-3.5">
        Disc Golf in <em class="italic text-sun">{name}</em>
      </h1>
      <p class="text-[17px] text-cream/90 max-w-[560px] mb-6">{lede}</p>
      <div class="bg-paper rounded-[11px] p-[7px] flex gap-1.5 max-w-[520px]">
        <input
          type="text"
          placeholder={`Filter ${name} courses — name, area, or vibe`}
          class="flex-1 border-none outline-none bg-transparent px-4 py-2.5 font-display text-base text-forest-deep placeholder:text-sage"
        />
        <button class="bg-clay text-white border-none px-6 rounded-[7px] font-bold text-sm cursor-pointer hover:bg-clay-deep transition-colors">
          Search
        </button>
      </div>
    </div>
  </div>
</section>
