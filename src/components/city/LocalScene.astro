---
interface Event {
  day: string;
  month: string;
  title: string;
  description: string;
  cta: string;
}

interface Club {
  icon: string;
  name: string;
  meta: string;
}

interface Props {
  events: Event[];
  clubs: Club[];
  cityName: string;
}

const { events, clubs, cityName } = Astro.props;
---

<section class="max-w-[1240px] mx-auto px-8 pb-20">
  <div class="eyebrow mb-3">§ 03 — The local scene</div>
  <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-3 max-w-[760px]">
    Leagues, tags &amp; <em class="italic text-clay">weekly rounds</em>
  </h2>
  <p class="text-base text-ink-soft max-w-[580px] mb-10">
    {cityName}'s disc golf community runs deep. Here's what's on this week, plus the clubs and shops that keep it going.
  </p>

  <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-14 items-start">
    <div class="ml-2 border-l-2 border-dashed border-line">
      {events.map((event) => (
        <div class="grid grid-cols-[74px_1fr_auto] gap-6 items-center py-[22px] pl-8 relative border-b border-line last:border-b-0">
          <div class="absolute -left-[9px] top-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-clay border-[3px] border-cream shadow-[0_0_0_2px_var(--color-line)]"></div>
          <div class="text-center">
            <div class="font-display font-semibold text-[28px] text-forest leading-none">{event.day}</div>
            <div class="font-mono text-[10px] font-bold text-clay uppercase mt-1">{event.month}</div>
          </div>
          <div>
            <h3 class="font-display font-semibold text-[19px] text-forest-deep mb-0.5">{event.title}</h3>
            <p class="text-[13px] text-ink-soft leading-[1.5]">{event.description}</p>
          </div>
          <a href="#" class="bg-forest text-cream px-[18px] py-[9px] rounded-full no-clip font-bold text-[13px] whitespace-nowrap hover:bg-clay transition-colors">
            {event.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="bg-paper border-[1.5px] border-forest rounded-[12px] p-[26px]">
      <h4 class="font-mono text-[11px] uppercase tracking-[1.5px] text-moss mb-4">Clubs &amp; pro shops</h4>
      {clubs.map((club) => (
        <div class="flex gap-3 items-center py-3 border-b border-dashed border-line last:border-b-0">
          <div class="w-8 h-8 rounded-lg bg-cream-2 grid place-items-center shrink-0 text-base">{club.icon}</div>
          <div>
            <div class="font-bold text-sm text-forest-deep">{club.name}</div>
            <div class="text-xs text-ink-soft">{club.meta}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
