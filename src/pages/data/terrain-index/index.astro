---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Schema from '../../../components/Schema.astro';
import hub from '../../../data/hubs/terrain-index.json';

const sorted = hub.cities; // already sorted by avgDifficultyRating desc
const most = sorted[0];
const least = sorted[sorted.length - 1];
const summary =
  `${most.name} has the most demanding terrain at an average difficulty of ${most.avgDifficultyRating} out of 5, ` +
  `while ${least.name} is the most forgiving at ${least.avgDifficultyRating}.`;

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: hub.name,
  description: hub.description,
  creator: { '@type': 'Organization', name: 'FindFrolf', url: 'https://www.findfrolf.com/' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isBasedOn: hub.sourceUrl,
  dateModified: hub.pulledAt,
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://www.findfrolf.com/data/terrain-index.json',
  },
};
---

<BaseLayout
  title="Disc Golf Terrain Index by City — Find Frolf Data Hub"
  description={hub.description}
  noindex
>
  <Fragment slot="head">
    <Schema schema={[datasetSchema]} />
  </Fragment>

  <section class="max-w-[1080px] mx-auto px-8 pt-20 pb-10">
    <div class="eyebrow mb-3">§ Data hub · Terrain</div>
    <h1 class="font-display font-normal text-[clamp(30px,4.5vw,52px)] leading-[1.04] tracking-[-1.5px] text-forest-deep mb-4 max-w-[820px]">
      Terrain <em class="italic text-clay">index</em>
    </h1>
    <p class="text-lg text-ink-soft max-w-[720px] leading-[1.6]">{summary}</p>
    <p class="font-mono text-[11px] text-moss mt-4 uppercase tracking-[1.5px]">
      difficulty rubric · pulled {hub.pulledAt}
    </p>
  </section>

  <section class="max-w-[1080px] mx-auto px-8 pb-20">
    <div class="overflow-x-auto rounded-[12px] border border-line bg-paper shadow-stamp">
      <table class="border-collapse text-[14px] min-w-[720px] w-full">
        <caption class="sr-only">Terrain challenge by city: average difficulty, wooded share, and average course length</caption>
        <thead>
          <tr class="text-left font-mono text-[11px] uppercase tracking-[1px] text-moss border-b border-line">
            <th class="px-5 py-3">City</th>
            <th class="px-5 py-3">Avg difficulty (1–5)</th>
            <th class="px-5 py-3">Wooded share</th>
            <th class="px-5 py-3">Avg course length</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((c, i) => (
            <tr class={i % 2 ? 'bg-paper' : 'bg-cream/40'}>
              <td class="px-5 py-3 font-semibold text-forest-deep">{c.name}</td>
              <td class="px-5 py-3 font-semibold">{c.avgDifficultyRating}</td>
              <td class="px-5 py-3">{c.woodedPct}%</td>
              <td class="px-5 py-3">{c.avgTotalFeet.toLocaleString()} ft</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 prose prose-forest max-w-[720px] text-ink-soft">
      <h2 class="font-display text-forest-deep">Methodology</h2>
      <p>
        The primary signal is the directory's 1–5 <code>difficultyRating</code>, whose rubric
        (<a href="/about/">documented in our sourcing guide</a>) already scores length, dense
        woods, elevation, and hazards — i.e. terrain. Wooded share and average course length are
        shown alongside for transparency. Values are course-level means per metro.
      </p>
      <p>
        A direct elevation-based version (USGS point elevations at each course) is a documented
        v2 improvement; this v1 uses the directory's own terrain rubric.
      </p>
    </div>
  </section>
</BaseLayout>
