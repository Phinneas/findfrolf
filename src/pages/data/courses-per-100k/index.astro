---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Schema from '../../../components/Schema.astro';
import hub from '../../../data/hubs/courses-per-100k.json';

const sorted = [...hub.cities].sort((a, b) => b.coursesPer100k - a.coursesPer100k);
const most = sorted[0];
const least = sorted[sorted.length - 1];
const summary =
  `${most.name} has the most courses per capita at ${most.coursesPer100k} per 100,000 residents, ` +
  `while ${least.name} has the fewest at ${least.coursesPer100k}.`;

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: hub.name,
  description: hub.description,
  creator: { '@type': 'Organization', name: 'FindFrolf', url: 'https://www.findfrolf.com/' },
  license: 'https://creativecommons.org/publicdomain/mark/1.0/',
  isBasedOn: hub.sourceUrl,
  dateModified: hub.pulledAt,
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://www.findfrolf.com/data/courses-per-100k.json',
  },
};
---

<BaseLayout
  title="Disc Golf Courses per 100,000 Residents — Find Frolf Data Hub"
  description={hub.description}
  noindex
>
  <Fragment slot="head">
    <Schema schema={[datasetSchema]} />
  </Fragment>

  <section class="max-w-[1080px] mx-auto px-8 pt-20 pb-10">
    <div class="eyebrow mb-3">§ Data hub · Course supply</div>
    <h1 class="font-display font-normal text-[clamp(30px,4.5vw,52px)] leading-[1.04] tracking-[-1.5px] text-forest-deep mb-4 max-w-[820px]">
      Courses <em class="italic text-clay">per 100,000</em>
    </h1>
    <p class="text-lg text-ink-soft max-w-[720px] leading-[1.6]">{summary}</p>
    <p class="font-mono text-[11px] text-moss mt-4 uppercase tracking-[1.5px]">
      2020 Census MSA population · pulled {hub.pulledAt}
    </p>
  </section>

  <section class="max-w-[1080px] mx-auto px-8 pb-20">
    <div class="overflow-x-auto rounded-[12px] border border-line bg-paper shadow-stamp">
      <table class="border-collapse text-[14px] min-w-[720px] w-full">
        <caption class="sr-only">Disc golf courses per 100,000 residents, ranked, for 15 US metros</caption>
        <thead>
          <tr class="text-left font-mono text-[11px] uppercase tracking-[1px] text-moss border-b border-line">
            <th class="px-5 py-3">City</th>
            <th class="px-5 py-3">Courses</th>
            <th class="px-5 py-3">Metro population (2020)</th>
            <th class="px-5 py-3">Courses / 100k</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((c, i) => (
            <tr class={i % 2 ? 'bg-paper' : 'bg-cream/40'}>
              <td class="px-5 py-3 font-semibold text-forest-deep">{c.name}</td>
              <td class="px-5 py-3">{c.courseCount}</td>
              <td class="px-5 py-3">{c.population2020.toLocaleString()}</td>
              <td class="px-5 py-3 font-semibold">{c.coursesPer100k}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 prose prose-forest max-w-[720px] text-ink-soft">
      <h2 class="font-display text-forest-deep">Methodology</h2>
      <p>
        Course counts come from the FindFrolf directory (<a href="/courses/">all courses</a>),
        grouped by metro. Population is the U.S. Census Bureau's 2020 decennial census
        metropolitan statistical area (MSA) total for each metro. Courses per 100,000 is
        <code>course count ÷ (population ÷ 100,000)</code>, rounded to one decimal.
      </p>
      <p>
        This measures course <em>supply relative to population</em>, not raw course count — a
        metro can have many courses yet rank low per capita if it is very large.
      </p>
    </div>
  </section>
</BaseLayout>
