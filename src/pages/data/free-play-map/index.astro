---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Schema from '../../../components/Schema.astro';
import hub from '../../../data/hubs/free-play-map.json';

const sorted = hub.cities; // already sorted by freeCount desc
const mostFree = sorted[0];
const mostPaid = [...sorted].sort((a, b) => b.paidCount - a.paidCount)[0];
const summary =
  `${mostFree.name} has the most free-to-play courses at ${mostFree.freeCount}, ` +
  `while ${mostPaid.name} has the most pay-to-play at ${mostPaid.paidCount}. ` +
  `${hub.freeCourses.length} free course points are mapped across the 15 metros.`;

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: hub.name,
  description: hub.description,
  creator: { '@type': 'Organization', name: 'FindFrolf', url: 'https://www.findfrolf.com/' },
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isBasedOn: hub.sourceUrl,
  dateModified: hub.pulledAt,
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'application/json',
    contentUrl: 'https://www.findfrolf.com/data/free-play-map.json',
  },
};
---

<BaseLayout
  title="Free-to-Play Disc Golf Map by City — Find Frolf Data Hub"
  description={hub.description}
  noindex
>
  <Fragment slot="head">
    <Schema schema={[datasetSchema]} />
  </Fragment>

  <section class="max-w-[1080px] mx-auto px-8 pt-20 pb-10">
    <div class="eyebrow mb-3">§ Data hub · Free play</div>
    <h1 class="font-display font-normal text-[clamp(30px,4.5vw,52px)] leading-[1.04] tracking-[-1.5px] text-forest-deep mb-4 max-w-[820px]">
      Free-to-play <em class="italic text-clay">map</em>
    </h1>
    <p class="text-lg text-ink-soft max-w-[720px] leading-[1.6]">{summary}</p>
    <p class="font-mono text-[11px] text-moss mt-4 uppercase tracking-[1.5px]">
      directory isFree flag · pulled {hub.pulledAt}
    </p>
  </section>

  <section class="max-w-[1080px] mx-auto px-8 pb-20">
    <div class="overflow-x-auto rounded-[12px] border border-line bg-paper shadow-stamp">
      <table class="border-collapse text-[14px] min-w-[720px] w-full">
        <caption class="sr-only">Free vs pay-to-play course distribution by city</caption>
        <thead>
          <tr class="text-left font-mono text-[11px] uppercase tracking-[1px] text-moss border-b border-line">
            <th class="px-5 py-3">City</th>
            <th class="px-5 py-3">Free courses</th>
            <th class="px-5 py-3">Pay-to-play</th>
            <th class="px-5 py-3">Free share</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((c, i) => (
            <tr class={i % 2 ? 'bg-paper' : 'bg-cream/40'}>
              <td class="px-5 py-3 font-semibold text-forest-deep">{c.name}</td>
              <td class="px-5 py-3 font-semibold">{c.freeCount}</td>
              <td class="px-5 py-3">{c.paidCount}</td>
              <td class="px-5 py-3">{c.freePct}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 prose prose-forest max-w-[720px] text-ink-soft">
      <h2 class="font-display text-forest-deep">Methodology</h2>
      <p>
        Each course in the directory carries an <code>isFree</code> flag and, when paid, a green
        fee. Free share is <code>free courses ÷ total courses</code> per metro. The dataset also
        ships the coordinates of every free course (<code>freeCourses</code>) so the point map can
        be rendered on a map — use the <a href="/finder/">course finder</a> to explore them
        interactively.
      </p>
      <p>
        "Free" means no green fee to play a round; parking or park entry fees at a handful of
        state/county parks are noted on the individual course pages.
      </p>
    </div>
  </section>
</BaseLayout>
