---
import BaseLayout from '../layouts/BaseLayout.astro';
import StateMap from '../components/state/StateMap.astro';
import { getAllCourses } from '../lib/data';

const allCourses = await getAllCourses();

// Group courses by state and order states by how many courses we've mapped.
const groups = new Map<string, { state: string; stateSlug: string; courses: typeof allCourses }>();
for (const course of allCourses) {
  const key = course.data.stateSlug;
  if (!groups.has(key)) {
    groups.set(key, { state: course.data.state, stateSlug: course.data.stateSlug, courses: [] });
  }
  groups.get(key)!.courses.push(course);
}
const stateGroups = [...groups.values()].sort((a, b) => b.courses.length - a.courses.length);
---

<BaseLayout
  title="Disc Golf Courses by State — Find Frolf"
  description="Browse every disc golf course mapped on Find Frolf, grouped by state. Each state shows an outline map with a pin for every course we've verified."
>
  <section class="max-w-[1240px] mx-auto px-8 pt-16 pb-10">
    <div class="eyebrow mb-3">§ The directory</div>
    <h1 class="font-display font-normal text-[clamp(34px,5vw,56px)] tracking-[-1.5px] text-forest-deep mb-4">
      Disc golf courses <em class="italic text-clay">by state</em>
    </h1>
    <p class="text-base text-ink-soft max-w-[620px] mb-8">
      Every course we've mapped so far, grouped by state. Each map shows a pin for every verified
      course — click a state to see its full list, or hover any pin to see the course.
    </p>
    <p class="font-mono text-[11px] uppercase tracking-[1.5px] text-moss">
      {allCourses.length} courses · {stateGroups.length} states
    </p>
  </section>

  <section class="max-w-[1240px] mx-auto px-8 pb-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {stateGroups.map((group) => (
        <div class="group bg-paper border-[1.5px] border-forest rounded-[14px] overflow-hidden shadow-stamp-sm flex flex-col transition-transform hover:-translate-y-1">
          <div class="h-[190px] p-3 bg-cream-2/60 border-b border-line">
            <StateMap stateName={group.state} courses={group.courses} />
          </div>
          <div class="flex items-center justify-between gap-4 px-5 py-4">
            <a href={`/${group.stateSlug}`} class="no-clip text-inherit hover:text-clay transition-colors">
              <span class="font-display font-semibold text-[21px] text-forest-deep tracking-[-0.5px] leading-none group-hover:text-clay transition-colors">
                {group.state}
              </span>
              <span class="block font-mono text-[10px] uppercase tracking-[1px] text-moss mt-1.5">
                View {group.state} courses →
              </span>
            </a>
            <div class="text-right shrink-0">
              <div class="font-display font-bold text-[26px] text-clay leading-none">{group.courses.length}</div>
              <div class="font-mono text-[10px] text-moss uppercase mt-1">courses</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
