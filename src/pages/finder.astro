---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
import { getAllCourses, courseUrl } from '../lib/data';
import { mapboxAccessToken } from '../lib/mapConfig';

const allCourses = await getAllCourses();

// Serialize course data for client-side filtering
const courseData = allCourses.map((c) => ({
  id: c.id,
  name: c.data.name,
  city: c.data.city,
  state: c.data.state,
  citySlug: c.data.citySlug,
  stateSlug: c.data.stateSlug,
  area: c.data.area,
  lat: c.data.location.lat,
  lng: c.data.location.lng,
  holes: c.data.holes,
  par: c.data.par,
  difficulty: c.data.difficulty,
  difficultyRating: c.data.difficultyRating,
  isFree: c.data.isFree,
  greenFee: c.data.greenFee,
  courseLength: c.data.courseLength,
  rating: c.data.rating,
  reviewCount: c.data.reviewCount,
  thumbnail: c.data.thumbnail,
  tags: c.data.tags,
  amenities: c.data.amenities,
  url: courseUrl(c),
}));

const finderSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'FindFrolf',
    description: 'The disc golf atlas — every course ranked and reviewed by locals.',
    url: 'https://findfrolf.com',
    logo: 'https://findfrolf.com/favicon.svg',
    areaServed: {
      '@type': 'Country',
      name: 'United States',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'FindFrolf',
    url: 'https://findfrolf.com',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://findfrolf.com/finder?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout
  title="Disc Golf Course Finder — Search & Map | Find Frolf"
  description="Find disc golf courses near you with our interactive map and filters. Search by city, difficulty, hole count, amenities, and more."
>
  <Fragment slot="head">
    <Schema schema={finderSchemas} />
  </Fragment>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.css" rel="stylesheet" />
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.js" defer></script>

  <div class="finder-page" data-courses={JSON.stringify(courseData)} data-mapbox-token={mapboxAccessToken}>
    <!-- Search header -->
    <div class="finder-header">
      <div class="finder-search-wrap">
        <div class="finder-search-bar">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input
            type="text"
            id="finder-search"
            placeholder="Search city, course, or state…"
            autocomplete="off"
          />
          <button id="near-me-btn" class="near-me-btn" title="Find courses near me">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
            </svg>
            <span class="near-me-label">Near me</span>
          </button>
        </div>
        <button id="filter-toggle-btn" class="filter-toggle-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M7 12h10M10 18h4"/>
          </svg>
          <span>Filters</span>
          <span id="active-filter-count" class="filter-count-badge" style="display:none;">0</span>
        </button>
      </div>
    </div>

    <!-- Filter panel -->
    <div id="filter-panel" class="filter-panel">
      <div class="filter-panel-inner">
        <!-- Difficulty -->
        <div class="filter-group">
          <label class="filter-label">Difficulty</label>
          <div class="filter-chips" data-filter="difficultyRating">
            <button class="filter-chip" data-value="1">★ Easy</button>
            <button class="filter-chip" data-value="2">★★ Casual</button>
            <button class="filter-chip" data-value="3">★★★ Moderate</button>
            <button class="filter-chip" data-value="4">★★★★ Hard</button>
            <button class="filter-chip" data-value="5">★★★★★ Brutal</button>
          </div>
        </div>

        <!-- Hole count -->
        <div class="filter-group">
          <label class="filter-label">Holes</label>
          <div class="filter-chips" data-filter="holes">
            <button class="filter-chip" data-value="9">9</button>
            <button class="filter-chip" data-value="18">18</button>
            <button class="filter-chip" data-value="27">27+</button>
          </div>
        </div>

        <!-- Course length -->
        <div class="filter-group">
          <label class="filter-label">Course length</label>
          <div class="filter-chips" data-filter="courseLength">
            <button class="filter-chip" data-value="short">Short</button>
            <button class="filter-chip" data-value="medium">Medium</button>
            <button class="filter-chip" data-value="long">Long</button>
          </div>
        </div>

        <!-- Free / Paid -->
        <div class="filter-group">
          <label class="filter-label">Cost</label>
          <div class="filter-chips" data-filter="isFree">
            <button class="filter-chip" data-value="true">Free</button>
            <button class="filter-chip" data-value="false">Paid</button>
          </div>
        </div>

        <!-- Amenities -->
        <div class="filter-group">
          <label class="filter-label">Amenities</label>
          <div class="filter-checkboxes" data-filter="amenities">
            <label class="filter-checkbox"><input type="checkbox" data-amenity="restrooms" /><span>Restrooms</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="parking" /><span>Parking</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="water" /><span>Water</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="lighting" /><span>Lighting</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="proShop" /><span>Pro shop</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="dogFriendly" /><span>Dog friendly</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="cartFriendly" /><span>Cart friendly</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="handicapAccessible" /><span>Accessible</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="camping" /><span>Camping</span></label>
          </div>
        </div>

        <button id="clear-filters-btn" class="clear-filters-btn">Clear all filters</button>
      </div>
    </div>

    <!-- Results count + view toggle -->
    <div class="results-bar">
      <span id="results-count" class="results-count">Loading courses…</span>
      <div class="view-toggle">
        <button id="view-list-btn" class="view-toggle-btn active" data-view="list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <span>List</span>
        </button>
        <button id="view-map-btn" class="view-toggle-btn" data-view="map">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
          <span>Map</span>
        </button>
      </div>
    </div>

    <!-- Main content area -->
    <div class="finder-content">
      <!-- List view -->
      <div id="list-view" class="list-view active">
        <div id="course-list" class="course-list"></div>
        <div id="no-results" class="no-results" style="display:none;">
          <div class="no-results-inner">
            <div class="font-display text-[40px] text-sage mb-2">∅</div>
            <h3 class="font-display font-semibold text-[20px] text-forest-deep mb-1">No courses match</h3>
            <p class="text-sm text-ink-soft">Try clearing some filters or searching a different area.</p>
            <button id="no-results-clear" class="clear-filters-btn mt-4">Clear all filters</button>
          </div>
        </div>
      </div>

      <!-- Map view -->
      <div id="map-view" class="map-view">
        <div id="map-container" class="map-container"></div>
      </div>
    </div>
  </div>

  <style>
    /* ── Finder page layout ── */
    .finder-page {
      --header-h: auto;
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Search header */
    .finder-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-cream);
      padding: 1rem 0 0.75rem;
    }

    .finder-search-wrap {
      display: flex;
      gap: 0.5rem;
      align-items: stretch;
    }

    .finder-search-bar {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-paper);
      border: 1.5px solid var(--color-forest);
      border-radius: 10px;
      padding: 0.25rem;
      box-shadow: var(--shadow-stamp-sm);
    }

    .search-icon {
      width: 20px;
      height: 20px;
      color: var(--color-moss);
      flex-shrink: 0;
      margin-left: 0.5rem;
    }

    .finder-search-bar input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      background: transparent;
      font-family: var(--font-display);
      font-size: 1rem;
      color: var(--color-forest-deep);
      padding: 0.5rem 0;
    }

    .finder-search-bar input::placeholder {
      color: var(--color-sage);
    }

    .near-me-btn {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--color-forest);
      color: var(--color-cream);
      border: none;
      border-radius: 7px;
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
    }

    .near-me-btn:hover {
      background: var(--color-clay);
    }

    .near-me-btn svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    .near-me-btn.active {
      background: var(--color-clay);
    }

    .near-me-label {
      display: none;
    }

    @media (min-width: 480px) {
      .near-me-label {
        display: inline;
      }
    }

    .filter-toggle-btn {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--color-paper);
      border: 1.5px solid var(--color-line);
      border-radius: 10px;
      padding: 0.5rem 0.85rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-forest);
      cursor: pointer;
      white-space: nowrap;
      transition: border-color 0.2s;
    }

    .filter-toggle-btn:hover {
      border-color: var(--color-forest);
    }

    .filter-toggle-btn svg {
      width: 18px;
      height: 18px;
    }

    .filter-count-badge {
      background: var(--color-clay);
      color: white;
      font-size: 0.7rem;
      font-weight: 800;
      border-radius: 99px;
      min-width: 18px;
      height: 18px;
      display: grid;
      place-items: center;
      padding: 0 5px;
    }

    /* Filter panel */
    .filter-panel {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, margin 0.3s ease;
      margin-top: 0;
    }

    .filter-panel.open {
      max-height: 600px;
      margin-top: 0.75rem;
    }

    .filter-panel-inner {
      background: var(--color-paper);
      border: 1.5px solid var(--color-line);
      border-radius: 12px;
      padding: 1.25rem;
      display: grid;
      gap: 1.25rem;
    }

    @media (min-width: 768px) {
      .filter-panel-inner {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem 2rem;
      }
    }

    @media (min-width: 1024px) {
      .filter-panel-inner {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .filter-label {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--color-moss);
    }

    .filter-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .filter-chip {
      padding: 0.35rem 0.7rem;
      border-radius: 99px;
      border: 1.5px solid var(--color-line);
      background: var(--color-paper);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-forest);
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }

    .filter-chip:hover {
      border-color: var(--color-forest);
    }

    .filter-chip.active {
      background: var(--color-clay);
      border-color: var(--color-clay);
      color: white;
    }

    .filter-checkboxes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1rem;
    }

    .filter-checkbox {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.82rem;
      color: var(--color-forest);
      cursor: pointer;
      user-select: none;
    }

    .filter-checkbox input {
      width: 16px;
      height: 16px;
      accent-color: var(--color-clay);
      cursor: pointer;
    }

    .clear-filters-btn {
      background: none;
      border: none;
      color: var(--color-clay);
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: underline;
      padding: 0;
      justify-self: start;
    }

    .clear-filters-btn:hover {
      color: var(--color-clay-deep);
    }

    /* Results bar */
    .results-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-line);
    }

    .results-count {
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--color-moss);
    }

    .view-toggle {
      display: flex;
      gap: 0;
      border: 1.5px solid var(--color-line);
      border-radius: 8px;
      overflow: hidden;
    }

    .view-toggle-btn {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      background: var(--color-paper);
      border: none;
      padding: 0.35rem 0.7rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-ink-soft);
      cursor: pointer;
      transition: all 0.15s;
    }

    .view-toggle-btn svg {
      width: 16px;
      height: 16px;
    }

    .view-toggle-btn.active {
      background: var(--color-forest);
      color: var(--color-cream);
    }

    /* Content area */
    .finder-content {
      position: relative;
      padding-top: 0.75rem;
      padding-bottom: 2rem;
    }

    /* List view */
    .list-view {
      display: none;
    }

    .list-view.active {
      display: block;
    }

    .course-list {
      display: flex;
      flex-direction: column;
    }

    .course-card {
      display: grid;
      grid-template-columns: 64px 1fr auto;
      gap: 0.75rem;
      align-items: center;
      padding: 0.85rem 0.25rem;
      border-bottom: 1px solid var(--color-line);
      text-decoration: none;
      color: inherit;
      transition: background 0.15s;
      cursor: pointer;
    }

    .course-card:hover {
      background: var(--color-cream-2);
    }

    .course-card.highlighted {
      background: var(--color-cream-2);
      border-left: 3px solid var(--color-clay);
      padding-left: 0.5rem;
    }

    .course-card-thumb {
      width: 64px;
      height: 50px;
      border-radius: 6px;
      background-size: cover;
      background-position: center;
      border: 1.5px solid var(--color-forest);
      flex-shrink: 0;
    }

    .course-card-info {
      min-width: 0;
    }

    .course-card-name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--color-forest-deep);
      letter-spacing: -0.3px;
      line-height: 1.15;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .course-card-meta {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-moss);
      margin-top: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .course-card-tags {
      display: flex;
      gap: 0.3rem;
      margin-top: 5px;
      flex-wrap: wrap;
    }

    .course-card-tag {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      background: var(--color-cream-2);
      color: var(--color-moss);
    }

    .course-card-tag.free {
      background: var(--color-sage);
      color: var(--color-forest-deep);
    }

    .course-card-right {
      text-align: right;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
    }

    .course-card-rating {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--color-clay);
      line-height: 1;
    }

    .course-card-distance {
      font-size: 0.72rem;
      color: var(--color-moss);
      font-weight: 600;
    }

    .course-card-spec {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--color-forest);
    }

    /* No results */
    .no-results {
      padding: 3rem 1rem;
      text-align: center;
    }

    .no-results-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Map view */
    .map-view {
      display: none;
    }

    .map-view.active {
      display: block;
    }

    .map-container {
      width: 100%;
      height: 70vh;
      min-height: 400px;
      border-radius: 12px;
      border: 1.5px solid var(--color-forest);
      overflow: hidden;
    }

    /* Desktop: side-by-side */
    @media (min-width: 1024px) {
      .view-toggle {
        display: none;
      }

      .finder-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        min-height: 600px;
      }

      .list-view {
        display: block !important;
      }

      .map-view {
        display: block !important;
        position: sticky;
        top: 80px;
      }

      .map-container {
        height: calc(100vh - 200px);
        min-height: 500px;
      }

      .course-card {
        grid-template-columns: 56px 1fr auto;
        gap: 0.6rem;
      }

      .course-card-thumb {
        width: 56px;
        height: 44px;
      }
    }

    /* Mapbox marker styles */
    .mapbox-marker {
      cursor: pointer;
    }

    .marker-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2.5px solid white;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: white;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
      transition: transform 0.15s;
    }

    .marker-badge:hover {
      transform: scale(1.15);
    }

    .marker-badge.top-rated {
      background: var(--color-sun);
      color: var(--color-forest-deep);
      border-color: var(--color-forest-deep);
    }

    .marker-badge.good {
      background: var(--color-clay);
    }

    .marker-badge.average {
      background: var(--color-moss);
    }

    /* Mapbox popup */
    .mapboxgl-popup-content {
      border-radius: 10px;
      padding: 0 !important;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

    .map-popup {
      width: 240px;
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .map-popup-img {
      width: 100%;
      height: 100px;
      object-fit: cover;
      border-radius: 10px 10px 0 0;
    }

    .map-popup-body {
      padding: 0.75rem;
    }

    .map-popup-name {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1rem;
      color: var(--color-forest-deep);
      line-height: 1.15;
    }

    .map-popup-meta {
      font-size: 0.75rem;
      color: var(--color-ink-soft);
      margin-top: 3px;
    }

    .map-popup-stats {
      display: flex;
      gap: 0.75rem;
      margin-top: 6px;
      font-size: 0.72rem;
      color: var(--color-moss);
    }

    .map-popup-rating {
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--color-clay);
      font-size: 1.1rem;
    }
  </style>

  <script is:inline>
    (function() {
      const page = document.querySelector('.finder-page');
      const courses = JSON.parse(page.dataset.courses || '[]');
      const mapboxToken = page.dataset.mapboxToken || '';

      // ── State ──
      const state = {
        search: '',
        difficultyRating: new Set(),
        holes: new Set(),
        courseLength: new Set(),
        isFree: new Set(),
        amenities: new Set(),
        userLocation: null,
        sortByDistance: false,
        view: 'list',
      };

      // ── DOM refs ──
      const searchInput = document.getElementById('finder-search');
      const nearMeBtn = document.getElementById('near-me-btn');
      const filterToggleBtn = document.getElementById('filter-toggle-btn');
      const filterPanel = document.getElementById('filter-panel');
      const activeFilterCount = document.getElementById('active-filter-count');
      const clearFiltersBtn = document.getElementById('clear-filters-btn');
      const noResultsClear = document.getElementById('no-results-clear');
      const resultsCount = document.getElementById('results-count');
      const courseList = document.getElementById('course-list');
      const noResults = document.getElementById('no-results');
      const viewListBtn = document.getElementById('view-list-btn');
      const viewMapBtn = document.getElementById('view-map-btn');
      const listView = document.getElementById('list-view');
      const mapView = document.getElementById('map-view');
      const mapContainer = document.getElementById('map-container');

      // ── Map instance ──
      let map = null;
      let markers = [];

      // ── Distance calculation (Haversine) ──
      function haversine(lat1, lng1, lat2, lng2) {
        const R = 3959; // miles
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLng = (lng2 - lng1) * Math.PI / 180;
        const a = Math.sin(dLat/2) ** 2 + Math.cos(lat1 * Math.PI/180) * Math.cos(lat2 * Math.PI/180) * Math.sin(dLng/2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      }

      function formatDistance(mi) {
        if (mi < 10) return mi.toFixed(1) + ' mi';
        return Math.round(mi) + ' mi';
      }

      // ── Filtering ──
      function getFilteredCourses() {
        let filtered = courses.filter((c) => {
          // Text search
          if (state.search) {
            const q = state.search.toLowerCase();
            const haystack = (c.name + ' ' + c.city + ' ' + c.state + ' ' + c.area + ' ' + c.tags.join(' ')).toLowerCase();
            if (!haystack.includes(q)) return false;
          }

          // Difficulty
          if (state.difficultyRating.size > 0) {
            if (!state.difficultyRating.has(String(c.difficultyRating))) return false;
          }

          // Holes
          if (state.holes.size > 0) {
            const holeKey = c.holes >= 27 ? '27' : String(c.holes);
            if (!state.holes.has(holeKey)) return false;
          }

          // Course length
          if (state.courseLength.size > 0) {
            if (!state.courseLength.has(c.courseLength)) return false;
          }

          // Free/Paid
          if (state.isFree.size > 0) {
            if (!state.isFree.has(String(c.isFree))) return false;
          }

          // Amenities
          if (state.amenities.size > 0) {
            for (const a of state.amenities) {
              if (!c.amenities[a]) return false;
            }
          }

          return true;
        });

        // Sort
        if (state.sortByDistance && state.userLocation) {
          filtered.sort((a, b) => {
            const da = haversine(state.userLocation.lat, state.userLocation.lng, a.lat, a.lng);
            const db = haversine(state.userLocation.lat, state.userLocation.lng, b.lat, b.lng);
            return da - db;
          });
        } else {
          filtered.sort((a, b) => b.rating - a.rating);
        }

        return filtered;
      }

      // ── Render list ──
      function renderList() {
        const filtered = getFilteredCourses();

        resultsCount.textContent = filtered.length + ' course' + (filtered.length !== 1 ? 's' : '') +
          (state.sortByDistance ? ' · sorted by distance' : ' · sorted by rating');

        if (filtered.length === 0) {
          courseList.innerHTML = '';
          noResults.style.display = 'flex';
          return;
        }

        noResults.style.display = 'none';

        courseList.innerHTML = filtered.map((c) => {
          let distHtml = '';
          if (state.sortByDistance && state.userLocation) {
            const d = haversine(state.userLocation.lat, state.userLocation.lng, c.lat, c.lng);
            distHtml = '<span class="course-card-distance">' + formatDistance(d) + '</span>';
          }

          const tags = c.tags.slice(0, 2).map(t =>
            '<span class="course-card-tag' + (t.toLowerCase() === 'free' ? ' free' : '') + '">' + t + '</span>'
          ).join('');

          return '<a class="course-card" href="' + c.url + '" data-course-id="' + c.id + '">' +
            '<div class="course-card-thumb" style="background-image:url(\'' + c.thumbnail + '\')"></div>' +
            '<div class="course-card-info">' +
              '<div class="course-card-name">' + c.name + '</div>' +
              '<div class="course-card-meta">' + c.city + ', ' + c.state + ' · ' + c.holes + ' holes · ' + c.difficulty + '</div>' +
              '<div class="course-card-tags">' + tags + '</div>' +
            '</div>' +
            '<div class="course-card-right">' +
              '<span class="course-card-rating">' + c.rating + '</span>' +
              distHtml +
              '<span class="course-card-spec">' + (c.isFree ? 'Free' : c.greenFee) + '</span>' +
            '</div>' +
          '</a>';
        }).join('');

        // Add click handlers for card-to-map interaction
        courseList.querySelectorAll('.course-card').forEach(card => {
          card.addEventListener('mouseenter', () => {
            const id = card.dataset.courseId;
            highlightMarker(id);
          });
        });
      }

      // ── Map ──
      function initMap() {
        if (map || !window.mapboxgl || !mapboxToken) return;

        map = new mapboxgl.Map({
          container: mapContainer,
          style: 'mapbox://styles/mapbox/outdoors-v12',
          center: [-97.0, 31.0], // Texas-centric default
          zoom: 5,
          accessToken: mapboxToken,
        });

        map.addControl(new mapboxgl.NavigationControl(), 'top-right');
      }

      function renderMap() {
        if (!map) return;

        // Clear existing markers
        markers.forEach(m => m.remove());
        markers = [];

        const filtered = getFilteredCourses();

        const bounds = new mapboxgl.LngLatBounds();

        filtered.forEach((c) => {
          const el = document.createElement('div');
          el.className = 'mapbox-marker';
          el.dataset.courseId = c.id;

          const badge = document.createElement('div');
          let badgeClass = 'marker-badge';
          if (c.rating >= 4.5) badgeClass += ' top-rated';
          else if (c.rating >= 4.0) badgeClass += ' good';
          else badgeClass += ' average';
          badge.className = badgeClass;
          badge.textContent = c.rating.toFixed(1);
          el.appendChild(badge);

          const popup = new mapboxgl.Popup({ offset: 20, closeButton: false })
            .setHTML(
              '<a class="map-popup" href="' + c.url + '">' +
                '<img class="map-popup-img" src="' + c.thumbnail + '" alt="' + c.name + '" />' +
                '<div class="map-popup-body">' +
                  '<div class="map-popup-name">' + c.name + '</div>' +
                  '<div class="map-popup-meta">' + c.city + ', ' + c.state + '</div>' +
                  '<div class="map-popup-stats">' +
                    '<span>' + c.holes + ' holes</span>' +
                    '<span>' + c.difficulty + '</span>' +
                    '<span class="map-popup-rating">★ ' + c.rating + '</span>' +
                  '</div>' +
                '</div>' +
              '</a>'
            );

          const marker = new mapboxgl.Marker(el)
            .setLngLat([c.lng, c.lat])
            .setPopup(popup)
            .addTo(map);

          el.addEventListener('click', () => {
            highlightCard(c.id);
          });

          markers.push(marker);
          bounds.extend([c.lng, c.lat]);
        });

        // Fit bounds
        if (filtered.length > 0) {
          if (filtered.length === 1) {
            map.flyTo({ center: [filtered[0].lng, filtered[0].lat], zoom: 12 });
          } else {
            map.fitBounds(bounds, { padding: 60 });
          }
        }
      }

      function highlightMarker(courseId) {
        markers.forEach(m => {
          const el = m.getElement();
          if (el.dataset.courseId === courseId) {
            el.style.zIndex = 999;
          }
        });
      }

      function highlightCard(courseId) {
        document.querySelectorAll('.course-card').forEach(card => {
          card.classList.toggle('highlighted', card.dataset.courseId === courseId);
          if (card.dataset.courseId === courseId) {
            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }

      // ── Update everything ──
      function update() {
        renderList();
        renderMap();
        updateFilterCount();
      }

      function updateFilterCount() {
        const count = state.difficultyRating.size + state.holes.size + state.courseLength.size +
          state.isFree.size + state.amenities.size;
        if (count > 0) {
          activeFilterCount.textContent = count;
          activeFilterCount.style.display = 'grid';
        } else {
          activeFilterCount.style.display = 'none';
        }
      }

      function clearFilters() {
        state.search = '';
        state.difficultyRating.clear();
        state.holes.clear();
        state.courseLength.clear();
        state.isFree.clear();
        state.amenities.clear();
        state.sortByDistance = false;
        state.userLocation = null;
        nearMeBtn.classList.remove('active');

        searchInput.value = '';
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        document.querySelectorAll('.filter-checkbox input').forEach(c => c.checked = false);

        update();
      }

      // ── Event handlers ──

      // Search
      let searchTimer;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          state.search = e.target.value.trim();
          update();
        }, 150);
      });

      // Near me
      nearMeBtn.addEventListener('click', () => {
        if (!navigator.geolocation) {
          alert('Geolocation is not supported by your browser.');
          return;
        }

        nearMeBtn.classList.add('active');
        nearMeBtn.querySelector('span').textContent = 'Locating…';

        navigator.geolocation.getCurrentPosition(
          (pos) => {
            state.userLocation = { lat: pos.coords.latitude, lng: pos.coords.longitude };
            state.sortByDistance = true;
            nearMeBtn.querySelector('span').textContent = 'Near me';
            update();

            // Fly map to user location
            if (map) {
              map.flyTo({ center: [pos.coords.longitude, pos.coords.latitude], zoom: 10 });
            }
          },
          (err) => {
            nearMeBtn.classList.remove('active');
            nearMeBtn.querySelector('span').textContent = 'Near me';
            alert('Could not get your location. ' + err.message);
          }
        );
      });

      // Filter toggle
      filterToggleBtn.addEventListener('click', () => {
        filterPanel.classList.toggle('open');
      });

      // Filter chips (multi-select within each group)
      document.querySelectorAll('.filter-chips').forEach(group => {
        const filterType = group.dataset.filter;

        group.querySelectorAll('.filter-chip').forEach(chip => {
          chip.addEventListener('click', () => {
            const value = chip.dataset.value;
            const targetSet = state[filterType];

            if (chip.classList.contains('active')) {
              chip.classList.remove('active');
              targetSet.delete(value);
            } else {
              chip.classList.add('active');
              targetSet.add(value);
            }

            update();
          });
        });
      });

      // Amenities checkboxes
      document.querySelectorAll('.filter-checkbox input').forEach(cb => {
        cb.addEventListener('change', () => {
          const amenity = cb.dataset.amenity;
          if (cb.checked) {
            state.amenities.add(amenity);
          } else {
            state.amenities.delete(amenity);
          }
          update();
        });
      });

      // Clear filters
      clearFiltersBtn.addEventListener('click', clearFilters);
      if (noResultsClear) noResultsClear.addEventListener('click', clearFilters);

      // View toggle (mobile)
      viewListBtn.addEventListener('click', () => {
        state.view = 'list';
        viewListBtn.classList.add('active');
        viewMapBtn.classList.remove('active');
        listView.classList.add('active');
        mapView.classList.remove('active');
      });

      viewMapBtn.addEventListener('click', () => {
        state.view = 'map';
        viewMapBtn.classList.add('active');
        viewListBtn.classList.remove('active');
        mapView.classList.add('active');
        listView.classList.remove('active');

        // Init map on first view
        if (!map) {
          setTimeout(() => {
            initMap();
            renderMap();
          }, 300);
        } else {
          setTimeout(() => map.resize(), 100);
        }
      });

      // ── Init ──
      renderList();

      // Auto-open filters on desktop
      if (window.innerWidth >= 1024) {
        filterPanel.classList.add('open');
        // Init map immediately on desktop
        setTimeout(() => {
          if (window.mapboxgl) {
            initMap();
            renderMap();
          } else {
            // Wait for Mapbox JS to load
            const checkMapbox = setInterval(() => {
              if (window.mapboxgl) {
                clearInterval(checkMapbox);
                initMap();
                renderMap();
              }
            }, 200);
            setTimeout(() => clearInterval(checkMapbox), 5000);
          }
        }, 500);
      }
    })();
  </script>
</BaseLayout>
