---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
import { getAllCourses, getAllCities, courseUrl, cityUrl, formatGreenFee } from '../lib/data';
import { mapboxAccessToken } from '../lib/mapConfig';

const allCourses = await getAllCourses();
const allCities = await getAllCities();

const citiesWithCounts = allCities
  .map((city) => ({
    ...city,
    courseCount: allCourses.filter((c) => c.data.citySlug === city.id).length,
  }))
  .sort((a, b) => b.courseCount - a.courseCount);

// Derive a state list (with live course counts) for the "by state" browse,
// targeting the "disc golf course finder by state" variant. Built from the
// live course set so every listed state has at least one mapped course.
const statesMap = new Map();
for (const c of allCourses) {
  const key = c.data.stateSlug;
  if (!statesMap.has(key)) {
    statesMap.set(key, { state: c.data.state, stateSlug: c.data.stateSlug, courseCount: 0 });
  }
  statesMap.get(key).courseCount++;
}
const statesWithCounts = [...statesMap.values()].sort((a, b) => b.courseCount - a.courseCount);

// Serialize course data for client-side filtering
const amenityTokens = (a: { [k: string]: boolean }) => {
  const t: string[] = [];
  if (a.dogFriendly) t.push('dog friendly', 'dogs');
  if (a.restrooms) t.push('restrooms', 'bathrooms');
  if (a.water) t.push('water', 'drinking water');
  if (a.lighting) t.push('lighting', 'lit', 'night play');
  if (a.proShop) t.push('pro shop');
  if (a.cartFriendly) t.push('cart friendly');
  if (a.handicapAccessible) t.push('accessible');
  if (a.camping) t.push('camping');
  if (a.parking) t.push('parking');
  return t.join(' ');
};

const courseData = allCourses.map((c) => {
  const searchText = [
    c.data.name,
    c.data.city,
    c.data.state,
    c.data.area,
    (c.data.tags || []).join(' '),
    c.data.isWooded ? 'wooded woods forest' : '',
    c.data.isBeginnerFriendly ? 'beginner friendly beginners beginner' : '',
    c.data.isFree ? 'free' : 'paid pay to play',
    amenityTokens(c.data.amenities),
  ]
    .join(' ')
    .toLowerCase();

  return {
    id: c.id,
    name: c.data.name,
    city: c.data.city,
    state: c.data.state,
    citySlug: c.data.citySlug,
    stateSlug: c.data.stateSlug,
    area: c.data.area,
    lat: c.data.location.lat,
    lng: c.data.location.lng,
    holes: c.data.holes,
    par: c.data.par,
    difficulty: c.data.difficulty,
    difficultyRating: c.data.difficultyRating,
    isFree: c.data.isFree,
    greenFee: c.data.greenFee,
    costLabel: formatGreenFee(c.data.isFree, c.data.greenFee),
    courseLength: c.data.courseLength,
    rating: c.data.rating,
    reviewCount: c.data.reviewCount,
    thumbnail: c.data.thumbnail,
    tags: c.data.tags,
    amenities: c.data.amenities,
    searchText,
    url: courseUrl(c),
  };
});

const finderSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'FindFrolf',
    description: 'The disc golf atlas — every course ranked and reviewed by locals.',
    url: 'https://findfrolf.com',
    logo: 'https://findfrolf.com/favicon.svg',
    areaServed: {
      '@type': 'Country',
      name: 'United States',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'FindFrolf',
    url: 'https://findfrolf.com',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://findfrolf.com/finder?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I find disc golf courses near me?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Tap the 'Near me' button on this page and the disc golf course finder sorts every course by distance from your location — you'll see the closest courses instantly, no typing required.",
        },
      },
      {
        '@type': 'Question',
        name: 'What does the FindFrolf disc golf course finder do?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The finder lets you search disc golf courses by city or course name, filter by difficulty, hole count, course length, cost, and amenities (restrooms, lighting, pro shop, dog-friendly, cart-friendly, accessible, camping), and explore every course on an interactive map.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is the disc golf course finder free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes — the finder is completely free, and so are most of the courses it lists. Each course page shows whether it is free to play or pay-to-play, with the current green fee.',
        },
      },
      {
        '@type': 'Question',
        name: 'How are disc golf courses ranked on FindFrolf?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Courses are ranked by player rating by default, and by distance when you use the near-me feature. Every course includes real hole-by-hole data, verified ratings, and editorial notes from local players.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which cities does the disc golf course finder cover?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The finder currently covers ${allCities.length} metro areas — Austin, Denver, Portland, Chicago, Seattle, Charlotte, Houston, Phoenix, Nashville, Raleigh–Durham, Dallas–Fort Worth, Kansas City, Atlanta, Cincinnati, and Minneapolis–St. Paul — with more courses added every week.`,
        },
      },
      {
        '@type': 'Question',
        name: 'Can I browse the disc golf course finder by state?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Yes — the Browse by state section lists every state we've mapped, each linking to a state page with the top-rated courses up front and a link back into the full finder to filter by difficulty, holes, cost, or amenities.",
        },
      },
    ],
  },
];
---

<BaseLayout
  title="Disc Golf Course Finder — Find Courses Near You | Find Frolf"
  description={`Find a disc golf course near you with the Find Frolf course finder. Search ${allCourses.length}+ courses by city, difficulty, hole count, and amenities — or use the map to discover courses nearby.`}
>
  <Fragment slot="head">
    <link rel="canonical" href="https://findfrolf.com/finder" />
    <Schema schema={finderSchemas} />
  </Fragment>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.css" rel="stylesheet" />
  <script src="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.js" defer></script>

  <!-- SEO hero -->
  <section class="max-w-[1240px] mx-auto px-8 pt-14 pb-8">
    <div class="eyebrow mb-3">§ The disc golf course finder</div>
    <h1 class="font-display font-normal text-[clamp(38px,6vw,64px)] leading-[0.95] tracking-[-2px] text-forest-deep max-w-[820px] mb-5">
      Find a disc golf course <em class="italic text-clay">near you</em>
    </h1>
    <p class="text-lg text-ink-soft max-w-[660px] leading-[1.7] mb-7">
      FindFrolf's disc golf course finder covers {allCourses.length} courses across {allCities.length} metro areas — search by city,
      filter by difficulty, hole count, cost, and amenities, or hit <b>near me</b> to see the closest
      courses ranked by distance. Every course is mapped, rated, and reviewed by the locals who play it.
    </p>
    <div class="flex gap-3 flex-wrap">
      <button id="hero-near-me-btn" class="bg-clay text-white px-6 py-3 rounded-full font-bold text-sm no-clip hover:bg-clay-deep transition-colors cursor-pointer">
        📍 Find courses near me
      </button>
      <a href="#by-city" class="bg-forest text-cream px-6 py-3 rounded-full font-bold text-sm no-clip hover:bg-forest-deep transition-colors">
        Browse by city ↓
      </a>
    </div>
  </section>

  <div class="finder-page" data-courses={JSON.stringify(courseData)} data-mapbox-token={mapboxAccessToken}>
    <!-- Search header -->
    <div class="finder-header">
      <div class="finder-search-wrap">
        <div class="finder-search-bar">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input
            type="text"
            id="finder-search"
            placeholder="Search city, course, or state…"
            autocomplete="off"
          />
          <button id="near-me-btn" class="near-me-btn" title="Find courses near me">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
            </svg>
            <span class="near-me-label">Near me</span>
          </button>
        </div>
        <button id="filter-toggle-btn" class="filter-toggle-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M7 12h10M10 18h4"/>
          </svg>
          <span>Filters</span>
          <span id="active-filter-count" class="filter-count-badge" style="display:none;">0</span>
        </button>
      </div>
    </div>

    <!-- Filter panel -->
    <div id="filter-panel" class="filter-panel">
      <div class="filter-panel-inner">
        <!-- Difficulty -->
        <div class="filter-group">
          <label class="filter-label">Difficulty</label>
          <div class="filter-chips" data-filter="difficultyRating">
            <button class="filter-chip" data-value="1">★ Easy</button>
            <button class="filter-chip" data-value="2">★★ Casual</button>
            <button class="filter-chip" data-value="3">★★★ Moderate</button>
            <button class="filter-chip" data-value="4">★★★★ Hard</button>
            <button class="filter-chip" data-value="5">★★★★★ Brutal</button>
          </div>
        </div>

        <!-- Hole count -->
        <div class="filter-group">
          <label class="filter-label">Holes</label>
          <div class="filter-chips" data-filter="holes">
            <button class="filter-chip" data-value="9">9</button>
            <button class="filter-chip" data-value="18">18</button>
            <button class="filter-chip" data-value="27">27+</button>
          </div>
        </div>

        <!-- Course length -->
        <div class="filter-group">
          <label class="filter-label">Course length</label>
          <div class="filter-chips" data-filter="courseLength">
            <button class="filter-chip" data-value="short">Short</button>
            <button class="filter-chip" data-value="medium">Medium</button>
            <button class="filter-chip" data-value="long">Long</button>
          </div>
        </div>

        <!-- Free / Paid -->
        <div class="filter-group">
          <label class="filter-label">Cost</label>
          <div class="filter-chips" data-filter="isFree">
            <button class="filter-chip" data-value="true">Free</button>
            <button class="filter-chip" data-value="false">Paid</button>
          </div>
        </div>

        <!-- Amenities -->
        <div class="filter-group">
          <label class="filter-label">Amenities</label>
          <div class="filter-checkboxes" data-filter="amenities">
            <label class="filter-checkbox"><input type="checkbox" data-amenity="restrooms" /><span>Restrooms</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="parking" /><span>Parking</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="water" /><span>Water</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="lighting" /><span>Lighting</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="proShop" /><span>Pro shop</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="dogFriendly" /><span>Dog friendly</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="cartFriendly" /><span>Cart friendly</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="handicapAccessible" /><span>Accessible</span></label>
            <label class="filter-checkbox"><input type="checkbox" data-amenity="camping" /><span>Camping</span></label>
          </div>
        </div>

        <button id="clear-filters-btn" class="clear-filters-btn">Clear all filters</button>
      </div>
    </div>

    <!-- Results count + view toggle -->
    <div class="results-bar">
      <span id="results-count" class="results-count">Loading courses…</span>
      <div class="view-toggle">
        <button id="view-list-btn" class="view-toggle-btn active" data-view="list">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <span>List</span>
        </button>
        <button id="view-map-btn" class="view-toggle-btn" data-view="map">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
          <span>Map</span>
        </button>
      </div>
    </div>

    <!-- Main content area -->
    <div class="finder-content">
      <!-- List view -->
      <div id="list-view" class="list-view active">
        <div id="empty-state" class="empty-state">
          <div class="empty-state-inner">
            <div class="font-display text-[44px] text-sage mb-2">⌕</div>
            <h3 class="font-display font-semibold text-[24px] text-forest-deep mb-1">Search {allCourses.length} courses</h3>
            <p class="text-sm text-ink-soft max-w-[460px] mb-6 leading-[1.65]">
              Type a city, course, or state above — or tap <b>near me</b> — and the courses that
              match will appear here and on the map. Nothing loads until you search.
            </p>
            <div class="empty-state-chips">
              <button class="empty-chip" data-q="dog friendly">Dog friendly</button>
              <button class="empty-chip" data-q="wooded">Wooded</button>
              <button class="empty-chip" data-q="free">Free</button>
              <button class="empty-chip" data-q="beginner friendly">Beginner friendly</button>
              <button class="empty-chip" data-q="18 holes">18 holes</button>
            </div>
          </div>
        </div>
        <div id="course-list" class="course-list"></div>
        <div id="no-results" class="no-results" style="display:none;">
          <div class="no-results-inner">
            <div class="font-display text-[40px] text-sage mb-2">∅</div>
            <h3 class="font-display font-semibold text-[20px] text-forest-deep mb-1">No courses match</h3>
            <p class="text-sm text-ink-soft">Try clearing some filters or searching a different area.</p>
            <button id="no-results-clear" class="clear-filters-btn mt-4">Clear all filters</button>
          </div>
        </div>
      </div>

      <!-- Map view -->
      <div id="map-view" class="map-view">
        <div id="map-container" class="map-container"></div>
      </div>
    </div>
  </div>

  <!-- How it works -->
  <section class="max-w-[1240px] mx-auto px-8 py-20">
    <div class="eyebrow mb-3">§ How the finder works</div>
    <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-10 max-w-[760px]">
      From search to first tee in <em class="italic text-clay">three steps</em>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-paper border-[1.5px] border-forest rounded-[12px] p-7 shadow-stamp">
        <div class="font-display font-bold text-[40px] text-clay leading-none mb-4">01</div>
        <h3 class="font-display font-semibold text-[19px] text-forest-deep mb-2">Search or locate</h3>
        <p class="text-sm text-ink-soft leading-[1.65]">Type a city, course, or state — or tap <b>near me</b> and we'll use your location to find the closest courses automatically.</p>
      </div>
      <div class="bg-paper border-[1.5px] border-forest rounded-[12px] p-7 shadow-stamp">
        <div class="font-display font-bold text-[40px] text-clay leading-none mb-4">02</div>
        <h3 class="font-display font-semibold text-[19px] text-forest-deep mb-2">Filter to your round</h3>
        <p class="text-sm text-ink-soft leading-[1.65]">Narrow by difficulty, holes, length, free or paid, and the amenities that matter — restrooms, lighting, pro shop, dog-friendly, cart-friendly, accessible, camping.</p>
      </div>
      <div class="bg-paper border-[1.5px] border-forest rounded-[12px] p-7 shadow-stamp">
        <div class="font-display font-bold text-[40px] text-clay leading-none mb-4">03</div>
        <h3 class="font-display font-semibold text-[19px] text-forest-deep mb-2">Pick your course</h3>
        <p class="text-sm text-ink-soft leading-[1.65]">Compare ratings on the list or map, then open the course page for real hole-by-hole data, the signature hole, and tips from locals.</p>
      </div>
    </div>
  </section>

  <!-- Browse by city -->
  <section id="by-city" class="bg-cream-2 border-t border-b border-line">
    <div class="max-w-[1240px] mx-auto px-8 py-20">
      <div class="eyebrow mb-3">§ Disc golf course finder by city</div>
      <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-3 max-w-[760px]">
        Browse disc golf courses <em class="italic text-clay">by city</em>
      </h2>
      <p class="text-base text-ink-soft max-w-[580px] mb-10">
        The best courses in each metro, ranked and reviewed. More cities added every week.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[18px]">
        {citiesWithCounts.map((city) => (
          <a
            href={cityUrl(city)}
            class="flex items-center gap-4 bg-paper border-[1.5px] border-forest rounded-[10px] p-3 no-clip text-inherit transition-all hover:bg-cream hover:-translate-y-0.5"
          >
            <img
              src={`/images/city-${city.id}.svg`}
              alt={`${city.data.name} disc golf`}
              loading="lazy"
              class="w-[72px] h-[72px] rounded-[8px] object-cover border border-line shrink-0"
            />
            <div class="flex-1 min-w-0">
              <div class="font-display font-semibold text-[19px] text-forest-deep truncate">{city.data.name}</div>
              <div class="font-mono text-[11px] text-moss uppercase mt-0.5">{city.data.state}</div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-display font-bold text-[22px] text-clay leading-none">{city.courseCount}</div>
              <div class="font-mono text-[10px] text-moss uppercase mt-0.5">courses</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Browse by state -->
  <section class="max-w-[1240px] mx-auto px-8 py-20">
    <div class="eyebrow mb-3">§ Disc golf course finder by state</div>
    <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep mb-3 max-w-[760px]">
      Browse disc golf courses <em class="italic text-clay">by state</em>
    </h2>
    <p class="text-base text-ink-soft max-w-[580px] mb-10">
      Rather start at the state level? Each state page lists every course we've mapped there, with the
      top-rated picks up front and a link back into the full finder to filter by difficulty, holes, cost,
      or amenities.
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-[18px]">
      {statesWithCounts.map((s) => (
        <a
          href={`/${s.stateSlug}`}
          class="flex justify-between items-center bg-paper border-[1.5px] border-forest rounded-[10px] px-5 py-[18px] no-clip text-inherit transition-all hover:bg-cream hover:-translate-y-0.5"
        >
          <div>
            <div class="font-display font-semibold text-[19px] text-forest-deep">{s.state}</div>
            <div class="font-mono text-[11px] text-moss uppercase mt-0.5">{s.courseCount} courses</div>
          </div>
          <div class="font-display font-bold text-[22px] text-clay leading-none">→</div>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-[1240px] mx-auto px-8 py-20">
    <div class="eyebrow mb-3">§ Good to know</div>
    <h2 class="font-display font-normal text-[clamp(30px,4vw,46px)] leading-[1.04] tracking-[-1.2px] text-forest-deep max-w-[760px] mb-8">
      Disc golf course finder, <em class="italic text-clay">answered</em>
    </h2>
    <div class="mt-2">
      {[
        ['How do I find disc golf courses near me?', "Tap the <b>Near me</b> button on this page and the finder sorts every course by distance from your location — you'll see the closest courses instantly, no typing required."],
        ['What does the FindFrolf disc golf course finder do?', 'Search by city or course name, filter by difficulty, hole count, length, cost, and amenities, and explore every course on an interactive map.'],
        ['Is the disc golf course finder free?', "Yes — the finder is free, and so are most of the courses it lists. Each course page shows whether it's free to play or pay-to-play."],
        ['How are disc golf courses ranked?', 'By player rating by default, and by distance when you use near me. Every course includes real hole-by-hole data and verified ratings.'],
        ['Can I browse the disc golf course finder by state?', 'Yes — scroll to <b>Browse by state</b> below the city list. Each state page shows every course we\'ve mapped there, with the top-rated picks up front and a link back into the full finder to filter by difficulty, holes, cost, or amenities.'],
      ].map(([q, a]) => (
        <div class="border-b border-line py-6">
          <div class="font-display font-semibold text-[20px] text-forest-deep mb-2">{q}</div>
          <div class="text-[15px] text-ink-soft leading-[1.65] max-w-[820px]" set:html={a}></div>
        </div>
      ))}
    </div>
  </section>

  <style>
    /* ── Finder page layout ── */
    .finder-page {
      --header-h: auto;
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Search header */
    .finder-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-cream);
      padding: 1rem 0 0.75rem;
    }

    .finder-search-wrap {
      display: flex;
      gap: 0.5rem;
      align-items: stretch;
    }

    .finder-search-bar {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-paper);
      border: 1.5px solid var(--color-forest);
      border-radius: 10px;
      padding: 0.25rem;
      box-shadow: var(--shadow-stamp-sm);
    }

    .search-icon {
      width: 20px;
      height: 20px;
      color: var(--color-moss);
      flex-shrink: 0;
      margin-left: 0.5rem;
    }

    .finder-search-bar input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      background: transparent;
      font-family: var(--font-display);
      font-size: 1rem;
      color: var(--color-forest-deep);
      padding: 0.5rem 0;
    }

    .finder-search-bar input::placeholder {
      color: var(--color-sage);
    }

    .near-me-btn {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--color-forest);
      color: var(--color-cream);
      border: none;
      border-radius: 7px;
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
