---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Find Frolf" description="Page not found" noindex>
  <section class="max-w-[1240px] mx-auto px-8 py-32 text-center">
    <svg class="w-24 h-24 mx-auto mb-6"><use href="#ff-mark" /></svg>
    <h1 class="font-display font-normal text-[clamp(40px,6vw,72px)] tracking-[-2px] text-forest-deep mb-4">
      Off the <em class="italic text-clay">map</em>
    </h1>
    <p class="text-lg text-ink-soft max-w-[440px] mx-auto mb-8">
      This page went OB. Let's get you back to the fairway.
    </p>
    <a href="/" class="inline-flex items-center gap-2 bg-clay text-white px-6 py-3 rounded-full font-bold text-sm no-clip hover:bg-clay-deep transition-colors">
      Back to home →
    </a>
  </section>
</BaseLayout>
