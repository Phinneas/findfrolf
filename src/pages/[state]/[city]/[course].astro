---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Schema from '../../../components/Schema.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CourseHero from '../../../components/course/CourseHero.astro';
import StatBar from '../../../components/course/StatBar.astro';
import AboutProse from '../../../components/course/AboutProse.astro';
import Scorecard from '../../../components/course/Scorecard.astro';
import SignatureHole from '../../../components/course/SignatureHole.astro';
import Reviews from '../../../components/course/Reviews.astro';
import SidebarMap from '../../../components/course/SidebarMap.astro';
import SidebarFacts from '../../../components/course/SidebarFacts.astro';
import SidebarTournaments from '../../../components/course/SidebarTournaments.astro';
import NearbyCourses from '../../../components/course/NearbyCourses.astro';
import { getCollection } from 'astro:content';
import { getCourse, getCoursesBySlugs, courseUrl, formatGreenFee } from '../../../lib/data';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({
    params: {
      state: course.data.stateSlug,
      city: course.data.citySlug,
      course: course.id,
    },
    props: {
      courseSlug: course.id,
    },
  }));
}

const { courseSlug } = Astro.props as { courseSlug: string };
const course = await getCourse(courseSlug);

if (!course) {
  return Astro.redirect('/404');
}

const stateNames: Record<string, string> = {
  tx: 'Texas',
  nc: 'North Carolina',
};
const stateName = stateNames[course.data.stateSlug] ?? course.data.stateSlug.toUpperCase();

const nearbyCourses = await getCoursesBySlugs(course.data.nearbyCourseSlugs);

const location = `${course.data.area}, ${stateName}`;

// Parse street address from full address string
const addressParts = course.data.location.address.split(',');
const streetAddress = addressParts[0]?.trim() ?? '';
const zipMatch = course.data.location.address.match(/(\d{5})$/);
const postalCode = zipMatch?.[1] ?? '';

const coursePageUrl = `https://findfrolf.com${courseUrl(course)}`;
const greenFeeLabel = formatGreenFee(course.data.isFree, course.data.greenFee);

// Omit openingHours when it's genuinely unknown rather than emitting "Unknown".
const rawHours = course.data.facts?.hours;
const hasHours = !!rawHours && !/unknown/i.test(rawHours) && rawHours.trim() !== '';
const openingHours = rawHours === 'Dawn-dusk' ? 'Mo-Su 06:00-22:00' : rawHours;

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: course.data.name,
  description: `Disc golf at ${course.data.name} in ${course.data.area}. ${course.data.holes} holes, par ${course.data.par}, rated ${course.data.rating} by ${course.data.reviewCount} players.`,
  url: coursePageUrl,
  image: course.data.heroImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality: course.data.city,
    addressRegion: course.data.state,
    postalCode,
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: course.data.location.lat,
    longitude: course.data.location.lng,
  },
  ...(hasHours ? { openingHours } : {}),
  priceRange: greenFeeLabel,
  sport: 'Disc Golf',
  // No aggregateRating: the rating and count come from third-party player data
  // (UDisc), and Google's review-snippet policy only allows ratings collected
  // on this site. Re-add once Find Frolf has first-party reviews.
};
---

<BaseLayout
  title={`${course.data.name} — Find Frolf`}
  description={`Disc golf at ${course.data.name} in ${course.data.area}. ${course.data.holes} holes, par ${course.data.par}, rated ${course.data.rating} by ${course.data.reviewCount} players.`}
>
  <Fragment slot="head">
    <Schema schema={courseSchema} />
  </Fragment>
  <Breadcrumbs
    crumbs={[
      { label: 'Courses', href: '/courses' },
      { label: stateName, href: `/${course.data.stateSlug}` },
      { label: course.data.area, href: `/${course.data.stateSlug}/${course.data.citySlug}` },
      { label: course.data.name },
    ]}
  />

  <CourseHero
    name={course.data.name}
    heroImage={course.data.heroImage}
    rating={course.data.rating}
    reviewCount={course.data.reviewCount}
    tags={course.data.tags}
    location={location}
    stateSlug={course.data.stateSlug}
    citySlug={course.data.citySlug}
  />

  <StatBar
    holes={course.data.holes}
    par={course.data.par}
    totalFeet={course.data.totalFeet}
    pdgaTier={course.data.pdgaTier}
    difficulty={course.data.difficulty}
    greenFee={greenFeeLabel}
  />

  <div class="max-w-[1240px] mx-auto px-8 py-[70px] pb-[90px] grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-14 items-start">
    <main>
      <AboutProse paragraphs={course.data.aboutParagraphs} />

      {course.data.signatureHoleDescription && (
        <SignatureHole
          description={course.data.signatureHoleDescription}
          hole={course.data.holeData.find((h) => h.isSignature) ?? null}
        />
      )}

      <Scorecard holes={course.data.holeData} totalPar={course.data.par} totalFeet={course.data.totalFeet} />

      <Reviews reviews={course.data.reviews} reviewCount={course.data.reviewCount} avgRating={course.data.rating} />
    </main>

    <aside class="flex flex-col gap-6 lg:sticky lg:top-6">
      <SidebarMap address={course.data.location.address} lat={course.data.location.lat} lng={course.data.location.lng} />
      <SidebarFacts facts={course.data.facts} />
      <SidebarTournaments tournaments={course.data.tournaments} />
    </aside>
  </div>

  <!-- Back to directory: hub-and-spoke link from course page to its city + state directory -->
  <section class="max-w-[1240px] mx-auto px-8 py-16">
    <div class="bg-paper border-[1.5px] border-forest rounded-[12px] p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-stamp">
      <div>
        <div class="eyebrow mb-2">§ Keep exploring</div>
        <h2 class="font-display font-normal text-[26px] tracking-[-0.5px] text-forest-deep mb-2">
          More disc golf in <em class="italic text-clay">{course.data.city}</em>
        </h2>
        <p class="text-sm text-ink-soft max-w-[520px]">
          Back to the {course.data.city} course directory for every mapped course, browse the rest of {stateName}, or open the finder to search and filter across all cities.
        </p>
      </div>
      <div class="flex gap-3 flex-wrap">
        <a href={`/${course.data.stateSlug}/${course.data.citySlug}`} class="bg-forest text-cream px-5 py-2.5 rounded-full font-bold text-sm no-clip hover:bg-forest-deep transition-colors whitespace-nowrap">
          {course.data.city} courses →
        </a>
        <a href={`/${course.data.stateSlug}`} class="bg-forest text-cream px-5 py-2.5 rounded-full font-bold text-sm no-clip hover:bg-forest-deep transition-colors whitespace-nowrap">
          {stateName} courses →
        </a>
        <a href="/finder" class="bg-clay text-white px-5 py-2.5 rounded-full font-bold text-sm no-clip hover:bg-clay-deep transition-colors whitespace-nowrap">
          Course finder →
        </a>
      </div>
    </div>
  </section>

  {nearbyCourses.length > 0 && <NearbyCourses stateName={stateName} courses={nearbyCourses} />}
</BaseLayout>
