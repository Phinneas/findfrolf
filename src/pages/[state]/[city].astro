---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CityHero from '../../components/city/CityHero.astro';
import QuickFacts from '../../components/city/QuickFacts.astro';
import IntroProse from '../../components/city/IntroProse.astro';
import MapBand from '../../components/city/MapBand.astro';
import CourseRegister from '../../components/city/CourseRegister.astro';
import BestFor from '../../components/city/BestFor.astro';
import LocalScene from '../../components/city/LocalScene.astro';
import BrowseByArea from '../../components/city/BrowseByArea.astro';
import FAQ from '../../components/city/FAQ.astro';
import NearbyCities from '../../components/city/NearbyCities.astro';
import CTACard from '../../components/city/CTACard.astro';
import { getCollection } from 'astro:content';
import { getCity, getCoursesByCity, getCourse, courseUrl, deriveCityStats } from '../../lib/data';
import { interpolateStats } from '../../lib/stats';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { state: city.data.stateSlug, city: city.id },
  }));
}

const { state, city } = Astro.params;
const cityData = await getCity(city!);

if (!cityData) {
  return Astro.redirect('/404');
}

const courses = await getCoursesByCity(city!);

// Headline stats are derived from the live course set, not hand-maintained
// numbers in the city JSON, so the page can never contradict its listings.
const { quickFacts, statsAside } = deriveCityStats(courses);

// City JSON copy uses {{stats:...}} tokens for course counts so they can never
// go stale (see src/lib/stats.ts); interpolate before rendering or schema output.
const faqs = cityData.data.faqs.map((faq) => ({
  question: interpolateStats(faq.question),
  answer: interpolateStats(faq.answer),
}));
const nearbyCities = cityData.data.nearbyCities.map((n) => ({
  ...n,
  courseCount: interpolateStats(n.courseCount),
}));
const lede = interpolateStats(cityData.data.lede);

// Resolve map pins with course data
const resolvedPins = await Promise.all(
  cityData.data.mapPins.map(async (pin) => {
    const course = await getCourse(pin.courseSlug);
    return {
      rank: pin.rank,
      courseSlug: pin.courseSlug,
      courseName: course?.data.name ?? pin.courseSlug,
      courseRating: course?.data.rating ?? 0,
      x: pin.x,
      y: pin.y,
      isGold: pin.isGold,
      stateSlug: course?.data.stateSlug ?? state,
      citySlug: course?.data.citySlug ?? city,
    };
  }),
);

const citySchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Disc Golf Courses in ${cityData.data.name}, ${cityData.data.state}`,
  description: lede,
  numberOfItems: courses.length,
  itemListElement: courses.map((course, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'SportsActivityLocation',
      name: course.data.name,
      url: `https://www.findfrolf.com${courseUrl(course)}`,
    },
  })),
};

const schemas: any[] = [citySchema];

if (faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}
---

<BaseLayout
  title={`Disc Golf in ${cityData.data.name}, ${cityData.data.state} — Find Frolf`}
  description={lede}
>
  <Fragment slot="head">
    <Schema schema={schemas} />
  </Fragment>
  <Breadcrumbs
    crumbs={[
      { label: 'Courses', href: '/courses/' },
      { label: cityData.data.state, href: `/${state}` },
      { label: cityData.data.name },
    ]}
  />

  <CityHero
    name={cityData.data.name}
    heroImage={cityData.data.heroImage}
    heroFlag={cityData.data.heroFlag}
    lede={lede}
  />

  <QuickFacts facts={quickFacts} />

  <IntroProse paragraphs={cityData.data.introParagraphs} stats={statsAside} cityName={cityData.data.name} />

  <MapBand pins={resolvedPins} cityName={cityData.data.name} />

  <CourseRegister courses={courses} totalCount={courses.length} cityName={cityData.data.name} />

  <BestFor items={cityData.data.bestFor} cityName={cityData.data.name} />

  {(cityData.data.events.length > 0 || cityData.data.clubs.length > 0) && (
    <LocalScene events={cityData.data.events} clubs={cityData.data.clubs} cityName={cityData.data.name} />
  )}

  {cityData.data.areas.length > 0 && <BrowseByArea areas={cityData.data.areas} cityName={cityData.data.name} />}

  {faqs.length > 0 && <FAQ faqs={faqs} cityName={cityData.data.name} />}

  {nearbyCities.length > 0 && <NearbyCities cities={nearbyCities} stateName={cityData.data.state} />}

  <CTACard cityName={cityData.data.name} />
</BaseLayout>
