---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCities, getAllCourses, cityUrl } from '../lib/data';

const cities = await getAllCities();
const courses = await getAllCourses();

const citiesWithCounts = cities
  .map((city) => ({
    city,
    courseCount: courses.filter((c) => c.data.citySlug === city.id).length,
  }))
  .sort((a, b) => b.courseCount - a.courseCount);
---

<BaseLayout
  title="Disc Golf City Guides — Find Frolf"
  description={`Browse Find Frolf's ${cities.length} disc golf city guides — ranked courses, local tips, and the clubs that keep each metro's scene alive.`}
>
  <section class="max-w-[1240px] mx-auto px-8 pt-14 pb-8">
    <div class="eyebrow mb-3">§ City guides</div>
    <h1 class="font-display font-normal text-[clamp(36px,5.5vw,60px)] leading-[0.95] tracking-[-2px] text-forest-deep max-w-[820px] mb-5">
      Disc golf, <em class="italic text-clay">city by city</em>
    </h1>
    <p class="text-lg text-ink-soft max-w-[660px] leading-[1.7] mb-6">
      {cities.length} metro guides and counting — each one ranked by the locals who play it, with the
      courses, clubs, and tips that actually matter on the ground.
    </p>
  </section>

  <section class="max-w-[1240px] mx-auto px-8 py-10 pb-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[18px]">
      {citiesWithCounts.map(({ city, courseCount }) => (
        <a
          href={cityUrl(city)}
          class="flex justify-between items-center bg-paper border-[1.5px] border-forest rounded-[10px] px-5 py-[18px] no-clip text-inherit transition-all hover:bg-cream hover:-translate-y-0.5"
        >
          <div>
            <div class="font-display font-semibold text-[19px] text-forest-deep">{city.data.name}</div>
            <div class="font-mono text-[11px] text-moss uppercase mt-0.5">{city.data.state}</div>
          </div>
          <div class="text-right">
            <div class="font-display font-bold text-[22px] text-clay leading-none">{courseCount}</div>
            <div class="font-mono text-[10px] text-moss uppercase mt-0.5">courses</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
