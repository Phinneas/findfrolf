---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Affiliate Disclosure — Find Frolf"
  description="How Find Frolf handles affiliate links and recommendations."
>
  <section class="max-w-[760px] mx-auto px-8 py-20">
    <div class="eyebrow mb-4">§ Transparency</div>
    <h1 class="font-display font-normal text-[clamp(34px,5vw,52px)] tracking-[-1.5px] text-forest-deep leading-[1.05] mb-8">
      Affiliate Disclosure
    </h1>

    <p class="text-[17px] text-ink-soft leading-[1.7] max-w-[640px]">
      Find Frolf participates in the Infinite Discs{' '}
      <a
        href="https://infinitediscs.com/affiliate-program"
        class="text-clay underline underline-offset-2 hover:text-clay-deep"
      >
        affiliate program
      </a>. Some links to discs and gear earn us a small commission at no extra cost to you.
      We only recommend products we'd suggest to a friend on the tee pad.
    </p>
  </section>
</BaseLayout>
