# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — never commit actual keys.

# Used by scripts that query exa.ai (web search + content retrieval)
# for the metro course-count cross-check (docs/metro-course-counts.md).
EXA_API_KEY=

# Cloudflare D1 — used by scripts/seed-observations.mjs and
# scripts/export-trust.mjs (docs/HANDOFF-data-layer.md §7).
# Get these from the Cloudflare dashboard: account > Workers & Pages > D1.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Set to 1 to skip the trust export step (local/CI safety valve).
SKIP_TRUST_EXPORT=0
